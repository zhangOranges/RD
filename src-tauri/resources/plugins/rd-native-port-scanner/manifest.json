{
  "id": "rd-native-port-scanner",
  "name": "端口扫描",
  "version": "1.0.3",
  "apiVersion": "v1",
  "author": "RD",
  "description": "查询服务器开启的端口，支持 TCP/UDP 监听查看、进程详情、端口过滤与刷新。通过 ssh.exec 执行 ss/netstat 命令，解析结果以表格展示。",
  "category": "monitor",
  "entry": "index.html",
  "indexHtml": "index.html",
  "icon": "icon.svg",
  "permissions": [
    "server.read",
    "ssh.run",
    "ui.inject-menu",
    "ui.notification",
    "theme.read",
    "log.read"
  ],
  "minRdVersion": "0.1.90",
  "hotReload": true
}
