  "icon": "icon.svg",
  "permissions": [
    "tunnel.manage",
    "server.read",
    "ui.inject-menu",
    "ui.notification",
    "ui.dialog",
    "theme.read",
    "storage.read",
    "storage.write",
    "log.read"
  ],
  "minRdVersion": "0.1.90",
  "hotReload": false
}
