{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RD",
  "version": "0.1.10",
  "identifier": "com.administrator.rd",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RD",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "dragDropEnabled": false,
        "backgroundColor": "#050810"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "deb",
      "appimage",
      "dmg",
      "app"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIwRDQwRTdGQ0VENDM0RkUKUldUK05OVE9mdzdVc05HZDBrWU9pWElETnlyNmdZRUJwL2FMMVc2VXhpL0Nxb1k4eGw4UVBJKzQK",
      "endpoints": [
        "https://github.com/zhangOranges/RD/releases/latest/download/latest.json"
      ],
      "dialog": false
    }
  }
}
