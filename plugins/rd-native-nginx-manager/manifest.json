{
  "id": "rd-native-nginx-manager",
  "name": "Nginx 管理",
  "version": "1.0.4",
  "apiVersion": "v1",
  "author": "RD",
  "description": "通过 SSH 管理远程主机上的 Nginx：启停 / 重载、运行状态与版本、access & error 日志查看。",
  "category": "monitor",
  "entry": "index.html",
  "indexHtml": "index.html",
  "icon": "icon.svg",
  "permissions": [
    "server.read",
    "ssh.run",
    "ui.dialog",
    "ui.notification",
    "ui.inject-menu",
    "theme.read",
    "storage.read",
    "storage.write",
    "log.read"
  ],
  "minRdVersion": "0.1.90",
  "hotReload": true
}
